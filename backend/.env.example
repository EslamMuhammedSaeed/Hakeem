# MySQL connection. Empty password is written as "root:@"
DATABASE_URL="mysql://root:@127.0.0.1:3306/egx"

# Shared secret the phone must send in the x-api-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_API_KEY="change-me"

PORT=4000
NODE_ENV=development

# Comma separated list of allowed browser origins for the dashboard
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Only notifications from these Android packages are treated as trade candidates.
# Leave empty to accept every package. Comma separated.
ALLOWED_PACKAGES=""

# Timezone used when a notification carries no timestamp
DEFAULT_TIMEZONE="Africa/Cairo"

# Signs the dashboard session cookie. At least 32 characters.
# Production refuses the value below.
JWT_SECRET="dev-only-change-this-secret-key-32b"

# Inserted on first boot only, when the User table is empty. Later changes here
# do not reset an existing password. Production refuses this password.
SEED_USER_EMAIL="owner@localhost"
SEED_USER_PASSWORD="el-hakeem-dev"

# When false (the default), the dashboard can be browsed without signing in.
# Writes (trades, reparse, mark price, notification delete) still require a
# session or x-api-key. Set to true to require a session or the API key for reads
# and for the live stream as well. Restart the backend after changing it.
REQUIRE_AUTH_FOR_READS=false

# When the session cookie is marked Secure.
# auto (default): Secure when the request is HTTPS, including X-Forwarded-Proto: https
#   behind the trusted proxy. Plain HTTP (a testing server without TLS) omits it.
# true: always Secure. false: never Secure. Production logs one warning if this is false.
COOKIE_SECURE=auto
