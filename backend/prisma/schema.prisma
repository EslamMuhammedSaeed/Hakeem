generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum NotificationStatus {
  PENDING
  PARSED
  FAILED
  IGNORED
}

enum TradeSide {
  BUY
  SELL
}

enum TradeSource {
  NOTIFICATION
  MANUAL
}

model RawNotification {
  id          Int                @id @default(autoincrement())
  receivedAt  DateTime           @default(now())
  postedAt    DateTime?
  appPackage  String?            @db.VarChar(191)
  title       String?            @db.Text
  body        String             @db.Text
  deviceId    String?            @db.VarChar(191)
  payload     Json
  dedupeHash  String             @unique @db.VarChar(64)
  status      NotificationStatus @default(PENDING)
  matchedRule String?            @db.VarChar(64)
  parseError  String?            @db.Text
  trade       Trade?

  @@index([status, receivedAt])
  @@index([receivedAt])
}

model Trade {
  id                Int         @id @default(autoincrement())
  rawNotificationId Int?        @unique
  rawNotification   RawNotification? @relation(fields: [rawNotificationId], references: [id], onDelete: SetNull)
  source            TradeSource @default(NOTIFICATION)
  side              TradeSide
  symbol            String      @db.VarChar(32)
  quantity          Decimal     @db.Decimal(18, 4)
  price             Decimal     @db.Decimal(18, 6)
  fees              Decimal     @default(0) @db.Decimal(18, 6)
  netAmount         Decimal     @db.Decimal(20, 6)
  currency          String      @default("EGP") @db.VarChar(8)
  executedAt        DateTime
  note              String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([symbol])
  @@index([executedAt])
  @@index([symbol, executedAt])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Instrument {
  id                Int       @id @default(autoincrement())
  code              String    @unique @db.VarChar(32)
  nameAr            String?   @db.VarChar(191)
  nameEn            String?   @db.VarChar(191)
  markPrice         Decimal?  @db.Decimal(18, 6)
  markPriceUpdatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
